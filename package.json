{
  "name": "monke-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Bun CLI for isolated per-session repo worktrees, local env rewrites, and distributed agent skills.",
  "keywords": [
    "agent-skills",
    "distributed-skills"
  ],
  "homepage": "https://github.com/monke-together-strong/monke-tools#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/monke-together-strong/monke-tools.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "skills",
    "!skills/_artifacts"
  ],
  "type": "module",
  "scripts": {
    "install:local": "sh ./scripts/install-local.sh",
    "skills:import": "bun run scripts/import-skills.ts",
    "skills:update": "bun run scripts/update-skills.ts",
    "tegami": "bun run scripts/tegami.mts",
    "prototype:merged-cleanup": "bun tmp/merged-worktree-cleanup-prototype/prototype.ts",
    "prototype:merged-cleanup-real-gh": "bun tmp/merged-worktree-cleanup-real-gh/prototype.ts",
    "typecheck": "tsc",
    "test": "bunx --bun vp test run",
    "lint": "vp lint src scripts __tests__ skills/internal --fix",
    "lint:check": "vp lint src scripts __tests__ skills/internal",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "prepare": "vp config"
  },
  "dependencies": {
    "@clack/core": "0.5.0",
    "@clack/prompts": "0.11.0",
    "@commander-js/extra-typings": "~15.0.0",
    "commander": "~15.0.0",
    "picocolors": "1.1.1",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tegami": "1.2.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.6"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "packageManager": "bun@1.3.11"
}
