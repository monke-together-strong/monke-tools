{
  "name": "monke-tools",
  "private": true,
  "description": "Bun CLI for isolated per-session repo worktrees, local env rewrites, and distributed agent skills.",
  "keywords": [
    "agent-skills",
    "distributed-skills"
  ],
  "homepage": "https://github.com/monke-together-strong/monke-tools#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/monke-together-strong/monke-tools.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "install:local": "sh ./scripts/install-local.sh",
    "skills:import": "bun run scripts/import-skills.ts",
    "skills:update": "bun run scripts/update-skills.ts",
    "tegami": "bun run scripts/tegami.mts",
    "test": "bunx --bun vp test run",
    "prepare": "vp config"
  },
  "dependencies": {
    "@clack/core": "0.5.0",
    "@clack/prompts": "0.11.0",
    "@commander-js/extra-typings": "~15.0.0",
    "@sindresorhus/is": "^8.1.0",
    "commander": "~15.0.0",
    "mdast-util-to-string": "4.0.0",
    "picocolors": "1.1.1",
    "yaml": "^2.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "tegami": "1.2.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unist-util-visit": "5.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "packageManager": "bun@1.4.0"
}
