{
  "extends": "./packages/oxc-config/base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "tests/**/*.ts",
    "packages/**/*.ts",
    "skills/internal/agent-session-retrospective/scripts/**/*.ts",
    "skills/internal/betterstack-cli/scripts/**/*.ts",
    "vite.config.ts"
  ]
}
